# NU-ARB market-data endpoints (.env.example)
# Copy to .env for local use. Do not commit real credentials or secrets.
# These are official public exchange endpoints, NOT proxy servers.
# The *_PROXY_URL values below are example routes for a proxy gateway you operate;
# change the host/port/routes to match your actual gateway implementation.

# MEXC
MEXC_REST_URL=https://api.mexc.com
MEXC_WS_URL=wss://wbs-api.mexc.com/ws
MEXC_PROXY_URL=http://localhost:8080/mexc

# Bybit (V5 public Spot stream; use /linear for linear derivatives)
BYBIT_REST_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/spot
BYBIT_PROXY_URL=http://localhost:8080/bybit

# HTX
HTX_REST_URL=https://api.huobi.pro
HTX_WS_URL=wss://api.huobi.pro/ws
HTX_PROXY_URL=http://localhost:8080/htx

# KuCoin: WebSocket endpoint/token must be obtained dynamically from bullet-public.
KUCOIN_REST_URL=https://api.kucoin.com
KUCOIN_WS_BOOTSTRAP_URL=https://api.kucoin.com/api/v1/bullet-public
KUCOIN_PROXY_URL=http://localhost:8080/kucoin

# Binance Spot
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_COMBINED_WS_URL=wss://stream.binance.com:9443/stream
BINANCE_PROXY_URL=http://localhost:8080/binance

# Optional: Bybit linear public market stream
BYBIT_LINEAR_WS_URL=wss://stream.bybit.com/v5/public/linear
