# Control-service only. Keep the real file out of source control.
ARBX_APP_DB=/data/arbx_app.sqlite3
APP_SECURE_COOKIE=1
ENGINE_PROXY_TOKEN=replace-with-a-random-service-token
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
# Enable only after HTTPS, persistent storage, and the control-plane preflight are configured.
ARBX_LIVE_TRADING_ENABLED=0
# Reconnect live-capable saved API keys and refresh balances on this interval.
ARBX_ACCOUNT_REFRESH_SECONDS=60
