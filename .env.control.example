# Control-service only. Keep the real file out of source control.
ARBX_APP_DB=/data/arbx_app.sqlite3
APP_SECURE_COOKIE=1
APP_PUBLIC_URL=https://your-dashboard.example
ENGINE_PROXY_TOKEN=replace-with-a-random-service-token
CREDENTIAL_ENCRYPTION_KEY=replace-with-64-hex-characters
# Password recovery is enabled only when the SMTP sender is configured on the control service.
CONTROL_EMAIL_HOST=smtp.example.com
CONTROL_EMAIL_PORT=587
CONTROL_EMAIL_FROM=NU-ARB <no-reply@example.com>
CONTROL_EMAIL_USERNAME=
CONTROL_EMAIL_PASSWORD=
CONTROL_EMAIL_USE_SSL=0
CONTROL_EMAIL_STARTTLS=1
# Safe defaults: live execution is unavailable unless every independent switch is deliberately enabled.
BOT_MODE=paper
BOT_ALLOW_ORDERS=0
BOT_CROSS_LIVE=0
ARBX_LIVE_TRADING_ENABLED=0
